{
      "version": 2,
      "buildCommand": "npm run build",
      "outputDirectory": "dist",
      "env": {
              "NODE_ENV": "production"
      },
      "functions": {
              "server/_core/index.ts": {
                        "runtime": "nodejs18.x",
                        "memory": 1024,
                        "maxDuration": 60
              }
      },
      "routes": [
              {
                        "src": "/api/trpc/(.*)",
                        "dest": "server/_core/index.ts",
                        "methods": ["GET", "POST", "PUT", "DELETE", "PATCH"]
              },
              {
                        "src": "/auth/(.*)",
                        "dest": "server/_core/index.ts",
                        "methods": ["GET", "POST"]
              },
              {
                        "src": "/uploads/(.*)",
                        "dest": "server/_core/index.ts",
                        "methods": ["GET", "POST"]
              },
              {
                        "src": "/health",
                        "dest": "server/_core/index.ts",
                        "methods": ["GET"]
              },
              {
                        "src": "/(.*)",
                        "dest": "/index.html",
                        "methods": ["GET"]
              }
      ]
}
