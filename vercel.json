{
    "version": 2,
    "builds": [
          {
                  "src": "package.json",
                  "use": "@vercel/static-build",
                  "config": { "distDir": "dist/public" }
          },
          {
                  "src": "server/_core/index.ts",
                  "use": "@vercel/node"
          }
    ],
    "routes": [
          {
                  "src": "/api/trpc/(.*)",
                  "dest": "server/_core/index.ts"
          },
          {
                  "src": "/auth/(.*)",
                  "dest": "server/_core/index.ts"
          },
          {
                  "src": "/uploads/(.*)",
                  "dest": "server/_core/index.ts"
          },
          {
                  "src": "/health",
                  "dest": "server/_core/index.ts"
          },
          {
                  "src": "/(.*)",
                  "dest": "/$1",
                  "continue": true
          },
          {
                  "handle": "filesystem"
          },
          {
                  "src": "/(.*)",
                  "dest": "/index.html"
          }
    ]
}
